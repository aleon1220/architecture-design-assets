          <mxGeometry height="60" width="320" x="1075" y="300" as="geometry" />
        </mxCell>
        <mxCell id="script-b3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F8F5;strokeColor=#00A389;fontSize=10;align=left;spacingLeft=8;" value="&lt;b&gt;rhel-developer-init.sh&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 9px; color: #334155;&quot;&gt;• RHEL 9 subscription &amp;amp; entitlement manager&lt;br&gt;• Runs &lt;b&gt;subscription-manager register&lt;/b&gt;&lt;br&gt;• Starts &lt;b&gt;pcscd&lt;/b&gt; smartcard daemon &amp;amp; PKI repos&lt;/font&gt;" vertex="1">
