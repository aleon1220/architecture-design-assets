        <mxCell id="script-p4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF2F8;strokeColor=#002456;fontSize=10;align=left;spacingLeft=8;" value="&lt;b&gt;Set-VMProcessor (Nested Virt Helper)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 9px; color: #334155;&quot;&gt;• Hyper-V nested virtualization configuration&lt;br&gt;• &lt;b&gt;-ExposeVirtualizationExtensions $true&lt;/b&gt;&lt;br&gt;• Enables KVM/QEMU inside WSL2/Hyper-V&lt;/font&gt;" vertex="1">
